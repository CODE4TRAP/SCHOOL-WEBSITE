<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <radialGradient id="hGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#FFF3E0" />
      <stop offset="100%" stop-color="#FFE082" />
    </radialGradient>
  </defs>
  <circle cx="100" cy="100" r="95" fill="url(#hGrad)" stroke="#FFA000" stroke-width="4"/>
  <!-- Gift Box / Birthday Cake -->
  <rect x="65" y="105" width="70" height="55" rx="6" fill="#E91E63" />
  <rect x="60" y="90" width="80" height="20" rx="4" fill="#9C27B0" />
  <!-- Ribbon -->
  <line x1="100" y1="90" x2="100" y2="160" stroke="#FFEB3B" stroke-width="12"/>
  <line x1="65" y1="130" x2="135" y2="130" stroke="#FFEB3B" stroke-width="10"/>
  <!-- Balloons -->
  <circle cx="70" cy="55" r="22" fill="#2196F3" />
  <circle cx="130" cy="55" r="22" fill="#4CAF50" />
  <circle cx="100" cy="40" r="24" fill="#FF5722" />
</svg>