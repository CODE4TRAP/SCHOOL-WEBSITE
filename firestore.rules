rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- INQUIRIES ---
    // Prospective parents can submit inquiries; authenticated admins can read and manage
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // --- ADMISSIONS ---
    // Public applicants can submit admission registrations; authenticated admins can read and manage
    match /admissions/{admissionId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // --- NOTICES ---
    // Public read-only; authenticated admins can create and edit
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- ADMINS COLLECTION ---
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }

    // Default: block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
